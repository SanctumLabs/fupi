{
  "uid": "fupi-service",
  "title": "Fupi service",
  "tags": [
    "fupi"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {"id":1,"type":"stat","title":"Requests per second","gridPos":{"x":0,"y":0,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(http_server_request_duration_seconds_count{service_name=\"fupi\"}[5m]))","legendFormat":""}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]}},
    {"id":2,"type":"stat","title":"p99 latency","gridPos":{"x":6,"y":0,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"fupi\"}[5m])))","legendFormat":""}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":3,"type":"stat","title":"5xx ratio","gridPos":{"x":12,"y":0,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(http_server_request_duration_seconds_count{service_name=\"fupi\",http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{service_name=\"fupi\"}[5m]))","legendFormat":""}],"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":0.01}]}},"overrides":[]}},
    {"id":4,"type":"timeseries","title":"Requests per second by route","gridPos":{"x":0,"y":4,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (http_route) (rate(http_server_request_duration_seconds_count{service_name=\"fupi\"}[5m]))","legendFormat":"{{http_route}}"}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]}},
    {"id":5,"type":"timeseries","title":"Latency p50 / p95 / p99","gridPos":{"x":12,"y":4,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"fupi\"}[5m])))","legendFormat":"p50"},{"refId":"B","expr":"histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"fupi\"}[5m])))","legendFormat":"p95"},{"refId":"C","expr":"histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"fupi\"}[5m])))","legendFormat":"p99"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":6,"type":"logs","title":"Application logs (Elasticsearch)","gridPos":{"x":0,"y":12,"w":24,"h":9},"datasource":{"type":"elasticsearch","uid":"elasticsearch"},"targets":[{"refId":"A","query":"service.name:fupi","timeField":"@timestamp","metrics":[{"type":"logs","id":"1","settings":{"limit":"100"}}],"bucketAggs":[]}]},
    {"id":7,"type":"table","title":"Recent traces (Tempo)","gridPos":{"x":0,"y":21,"w":24,"h":9},"datasource":{"type":"tempo","uid":"tempo"},"targets":[{"refId":"A","queryType":"traceql","query":"{ resource.service.name = \"fupi\" }","limit":20}]},
    {"id":8,"type":"row","title":"Dependencies","gridPos":{"x":0,"y":30,"w":24,"h":1},"collapsed":false,"panels":[]},
    {"id":9,"type":"timeseries","title":"Postgres pool connections","gridPos":{"x":0,"y":31,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(pgxpool_acquired_connections{service_name=\"fupi\"})","legendFormat":"acquired"},{"refId":"B","expr":"sum(pgxpool_idle_connections{service_name=\"fupi\"})","legendFormat":"idle"},{"refId":"C","expr":"sum(pgxpool_max_connections{service_name=\"fupi\"})","legendFormat":"max"}],"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]}},
    {"id":10,"type":"timeseries","title":"Postgres pool waits per second","gridPos":{"x":12,"y":31,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(pgxpool_empty_acquire_total{service_name=\"fupi\"}[5m]))","legendFormat":"waits"}],"fieldConfig":{"defaults":{"unit":"ops"},"overrides":[]}},
    {"id":11,"type":"timeseries","title":"Redis commands per second","gridPos":{"x":0,"y":39,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (type, status) (rate(db_client_connections_use_time_milliseconds_count{service_name=\"fupi\",db_system=\"redis\"}[5m]))","legendFormat":"{{type}} {{status}}"}],"fieldConfig":{"defaults":{"unit":"ops"},"overrides":[]}},
    {"id":12,"type":"timeseries","title":"Redis command latency p99","gridPos":{"x":12,"y":39,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.99, sum by (le) (rate(db_client_connections_use_time_milliseconds_bucket{service_name=\"fupi\",db_system=\"redis\"}[5m])))","legendFormat":"p99"}],"fieldConfig":{"defaults":{"unit":"ms"},"overrides":[]}},
    {"id":13,"type":"row","title":"Rate limiting","gridPos":{"x":0,"y":47,"w":24,"h":1},"collapsed":false,"panels":[]},
    {"id":14,"type":"timeseries","title":"Instances on the in-memory rate limit fallback","description":"http.ratelimit.fallback.active summed over instances: each reports 1 while Redis fails and it limits requests in memory.","gridPos":{"x":0,"y":48,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(http_ratelimit_fallback_active{service_name=\"fupi\"})","legendFormat":"in fallback"}],"fieldConfig":{"defaults":{"unit":"short","min":0,"decimals":0},"overrides":[]}},
    {"id":15,"type":"timeseries","title":"Rate limiter decisions per second","description":"http.ratelimit.requests by group and outcome (allowed or limited).","gridPos":{"x":12,"y":48,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by (group, outcome) (rate(http_ratelimit_requests_total{service_name=\"fupi\"}[5m]))","legendFormat":"{{group}} {{outcome}}"}],"fieldConfig":{"defaults":{"unit":"ops"},"overrides":[]}}
  ]
}
